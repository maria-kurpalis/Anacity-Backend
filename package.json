{
  "name": "anacity-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal TypeScript, Express and PostgreSQL API",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:demo-login-api": "npm run build && node tests/demo-login-api.cjs",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev:frontend": "npm --prefix ../frontend run dev",
    "build:frontend": "npm --prefix ../frontend run build",
    "test:frontend": "npm run build && node tests/resident-frontend.cjs",
    "test:admin-frontend": "npm run build && node tests/admin-frontend.cjs",
    "test:admin-frontend-api": "npm run build && node tests/admin-frontend-api.cjs",
    "test:progress-api": "npm run build && node tests/request-progress-api.cjs",
    "db:migrate": "node dist/migrations/runner.js up",
    "db:migrate:undo": "node dist/migrations/runner.js down",
    "db:migrate:status": "node dist/migrations/runner.js status",
    "db:seed": "node dist/seeders/runner.js up",
    "db:seed:undo": "node dist/seeders/runner.js down",
    "db:seed:status": "node dist/seeders/runner.js status",
    "db:reset": "tsx src/scripts/resetDatabase.ts",
    "test:schema": "npm run build && node tests/schema.cjs",
    "test:reset": "npm run build && node tests/reset-database.cjs",
    "test:api": "npm run build && node tests/move-request-api.cjs",
    "test:admin-api": "npm run build && node tests/admin-move-request-api.cjs",
    "test:document-api": "npm run build && node tests/document-api.cjs",
    "test:workflow-collaboration-api": "npm run build && node tests/workflow-collaboration-api.cjs",
    "test:agent-api": "npm run build && node tests/agent-api.cjs",
    "test:ai-provider": "npm run build && node tests/ai-provider.cjs",
    "test:history-notification-api": "npm run build && node tests/history-notification-api.cjs",
    "test:dashboard-agent-history-api": "npm run build && node tests/dashboard-agent-history-api.cjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "umzug": "^3.8.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
